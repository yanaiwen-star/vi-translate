page { background: #f4f8f6; }
.phrase-page { min-height: 100vh; padding-bottom: 36rpx; color: #18251f; }
.hero { padding: 32rpx 28rpx 26rpx; background: linear-gradient(145deg, #07c160, #04a953); color: #fff; }
.hero-title { font-size: 40rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-subtitle { margin-top: 8rpx; font-size: 24rpx; opacity: .9; }
.search-box { display: flex; align-items: center; height: 76rpx; margin-top: 24rpx; padding: 0 22rpx; background: rgba(255,255,255,.96); border-radius: 20rpx; color: #1f2933; }
.search-icon { margin-right: 14rpx; color: #66756d; font-size: 34rpx; transform: rotate(-20deg); }
.search-box input { flex: 1; height: 76rpx; font-size: 27rpx; }
.clear { padding: 10rpx; color: #829087; font-size: 36rpx; }
.scene-picker-wrap { display: flex; align-items: center; padding: 20rpx 24rpx; background: #fff; border-bottom: 1rpx solid #e7eee9; }
.picker-label { margin-right: 20rpx; color: #637168; font-size: 25rpx; }
.scene-picker { flex: 1; }
.picker-value { display: flex; height: 68rpx; align-items: center; justify-content: space-between; padding: 0 22rpx; color: #087f43; background: #e9f9f0; border: 2rpx solid #ccefdc; border-radius: 16rpx; font-size: 27rpx; font-weight: 600; }
.picker-arrow { color: #478060; font-size: 34rpx; }
.scene-list { padding: 24rpx; }
.scene-section { margin-bottom: 30rpx; }
.scene-heading { display: flex; align-items: center; margin: 0 6rpx 16rpx; font-size: 29rpx; font-weight: 700; }
.scene-icon { margin-right: 10rpx; }
.scene-count { margin-left: auto; color: #849189; font-size: 22rpx; font-weight: 400; }
.phrase-card { margin-bottom: 16rpx; padding: 8rpx 22rpx; background: #fff; border: 1rpx solid #e7eee9; border-radius: 22rpx; box-shadow: 0 6rpx 20rpx rgba(28,76,49,.05); }
.phrase-row { display: flex; min-height: 92rpx; align-items: center; }
.language-tag { display: flex; width: 46rpx; height: 46rpx; flex: 0 0 auto; align-items: center; justify-content: center; color: #087c42; background: #e7f8ef; border-radius: 13rpx; font-size: 22rpx; font-weight: 700; }
.language-tag.vi { color: #6a45b8; background: #f0eafd; }
.phrase-text { flex: 1; padding: 18rpx; font-size: 28rpx; line-height: 1.5; }
.vietnamese .phrase-text { color: #4d347e; }
.divider { height: 1rpx; margin-left: 64rpx; background: #edf1ee; }
.audio-button { display: flex; width: 62rpx; height: 62rpx; flex: 0 0 auto; align-items: center; justify-content: center; padding: 0; border: 0; border-radius: 50%; color: #087f43; background: #e9f9f0; font-size: 22rpx; line-height: 62rpx; }
.audio-button::after { border: 0; }
.audio-button.playing { color: #fff; background: #07c160; box-shadow: 0 0 0 8rpx rgba(7,193,96,.12); }
.empty { margin: 32rpx 24rpx; padding: 90rpx 24rpx; border-radius: 22rpx; color: #7b8981; background: #fff; text-align: center; font-size: 26rpx; }
