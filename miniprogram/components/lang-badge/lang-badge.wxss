/* components/lang-badge/lang-badge.wxss */

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.badge.small {
  padding: 2rpx 12rpx;
  font-size: 20rpx;
}

.flag {
  font-size: 28rpx;
}

.badge.small .flag {
  font-size: 22rpx;
}

.name {
  font-size: 24rpx;
}

.badge.small .name {
  font-size: 20rpx;
}

.badge.lang-zh {
  background: #e8f0fe;
  color: var(--lang-zh);
}

.badge.lang-vie {
  background: #fce8e6;
  color: var(--lang-vie);
}