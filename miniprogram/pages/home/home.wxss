/* pages/home/home.wxss */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* Hero */
.hero {
  background: linear-gradient(150deg, #0D7C5C 0%, #0A6450 100%);
  padding: 60rpx 40rpx 56rpx;
  color: #fff;
}
.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
}
.brand-name {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.brand-en {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}
.hero-slogan {
  margin-top: 40rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.4;
}
.hero-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  opacity: 0.9;
  line-height: 1.5;
}
.hero-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 44rpx;
}
.btn-hero {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 20rpx 0;
  line-height: 1.4;
  border: none;
}
.btn-hero.primary {
  background: #fff;
  color: #0D7C5C;
}
.btn-hero.ghost {
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}
.btn-hero::after { border: none; }

/* Stats */
.stats {
  margin: -28rpx 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  position: relative;
  z-index: 2;
}
.stat {
  text-align: center;
  flex: 1;
}
.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
}
.stat-unit {
  font-size: 24rpx;
  margin-left: 4rpx;
}
.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}
.stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: var(--border);
}

/* Section */
.section {
  margin: 44rpx 32rpx 0;
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.section-more {
  font-size: 26rpx;
  color: var(--primary);
}

/* Service grid */
.service-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.service-card {
  width: calc(50% - 10rpx);
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}
.service-card:active { background: var(--primary-light); }
.service-icon { font-size: 48rpx; }
.service-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 16rpx;
  color: var(--text-primary);
}
.service-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  line-height: 1.5;
}

/* Advantages */
.adv-list { display: flex; flex-direction: column; gap: 20rpx; }
.adv-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}
.adv-icon {
  font-size: 44rpx;
  width: 72rpx;
  text-align: center;
}
.adv-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.adv-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  line-height: 1.6;
}

/* Contact CTA */
.contact-cta {
  margin: 44rpx 32rpx 0;
  text-align: center;
  background: linear-gradient(135deg, #E6F4EF 0%, #ffffff 100%);
  border: 2rpx solid #d4ebe2;
}
.cta-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.cta-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
}
.cta-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.btn-cta {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 18rpx 0;
  border: none;
}
.btn-cta.primary { background: var(--primary); color: #fff; }
.btn-cta.ghost {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}
.btn-cta::after { border: none; }

/* Footer */
.footer {
  margin: 44rpx 40rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-hint);
  line-height: 1.6;
}
