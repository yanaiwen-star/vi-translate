.detail-page { min-height: 100vh; padding: 24rpx; background: #f5f7fa; box-sizing: border-box; }.state { display: flex; min-height: 300rpx; align-items: center; justify-content: center; flex-direction: column; gap: 20rpx; color: #7b8794; background: #fff; border-radius: 22rpx; }.state button { color: #fff; background: #07c160; border-radius: 999rpx; }.state button::after { border: 0; }.example { display: inline-flex; margin-bottom: 16rpx; padding: 8rpx 18rpx; color: #855b00; background: #fff2cd; border-radius: 999rpx; font-size: 22rpx; }.main-card,.request-card,.example-action { padding: 28rpx; background: #fff; border-radius: 22rpx; }.head { display: flex; align-items: center; gap: 20rpx; }.avatar { display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; color: #078a48; background: #e6f8ee; border-radius: 22rpx; font-size: 36rpx; font-weight: 700; }.name { color: #1f2933; font-size: 34rpx; font-weight: 700; }.meta { margin-top: 7rpx; color: #7b8794; font-size: 24rpx; }.verify { margin-top: 20rpx; color: #9a6b00; font-size: 23rpx; }.verify.ok { color: #078a48; }.tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }.tag { padding: 8rpx 16rpx; color: #52606d; background: #f1f4f5; border-radius: 999rpx; font-size: 22rpx; }.tag.language { color: #087b43; background: #e8f8ef; }.section-title { margin-top: 30rpx; color: #1f2933; font-size: 27rpx; font-weight: 650; }.bio { margin-top: 12rpx; color: #52606d; font-size: 25rpx; line-height: 1.7; }.risk { margin-top: 24rpx; padding: 18rpx; color: #7a5b15; background: #fff8e4; border-radius: 14rpx; font-size: 22rpx; line-height: 1.6; }.contact-button,.example-action button { margin-top: 24rpx; color: #fff; background: #07c160; border-radius: 999rpx; }.contact-button::after,.example-action button::after { border: 0; }.example-action { margin-top: 20rpx; color: #697586; text-align: center; font-size: 24rpx; }.request-card { margin-top: 20rpx; }.request-title { font-size: 28rpx; font-weight: 650; }.request-card input { height: 82rpx; margin-top: 18rpx; padding: 0 20rpx; background: #f5f7fa; border-radius: 14rpx; font-size: 25rpx; }.request-tip { margin-top: 12rpx; color: #9a6b00; font-size: 21rpx; }.actions { display: flex; gap: 14rpx; margin-top: 20rpx; }.actions button { flex: 1; border-radius: 999rpx; font-size: 25rpx; }.actions .primary { color: #fff; background: #07c160; }.actions button::after { border: 0; }
