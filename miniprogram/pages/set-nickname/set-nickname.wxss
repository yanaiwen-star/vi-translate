/* pages/set-nickname/set-nickname.wxss */
.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 36rpx 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #666;
  line-height: 1.55;
  margin-bottom: 36rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f5f7fa;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.hint {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 36rpx;
  line-height: 1.5;
}

.btn-confirm {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07C160;
  color: #fff;
  font-size: 30rpx;
  border-radius: 14rpx;
  border: none;
  margin: 0;
}

.btn-confirm[disabled] {
  background: #c5e9d3;
  color: #fff;
}

.btn-confirm::after {
  border: none;
}

.link {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  margin-top: 24rpx;
}
