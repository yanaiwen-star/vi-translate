.edit-page { min-height: 100vh; padding: 24rpx 24rpx 70rpx; background: #f5f7fa; box-sizing: border-box; }.state { min-height: 300rpx; display: flex; align-items: center; justify-content: center; color: #7b8794; }.free-banner { padding: 28rpx; color: #fff; background: linear-gradient(135deg,#07c160,#00a870); border-radius: 22rpx; font-size: 23rpx; line-height: 1.6; }.free-title { font-size: 34rpx; font-weight: 700; }.error { margin-top: 18rpx; padding: 18rpx; color: #b42318; background: #fff0ee; border-radius: 14rpx; font-size: 23rpx; }.form-card { margin-top: 20rpx; padding: 12rpx 26rpx; background: #fff; border-radius: 22rpx; }.section-title { font-size: 28rpx; font-weight: 650; color: #1f2933; }.form-card > .section-title { padding: 20rpx 0 10rpx; }.field,.choice-row { display: flex; min-height: 90rpx; align-items: center; gap: 12rpx; border-bottom: 1rpx solid #edf0f2; }.field > text,.choice-row > text { width: 150rpx; color: #52606d; font-size: 25rpx; }.field input { flex: 1; text-align: right; font-size: 25rpx; }.field.block { align-items: flex-start; flex-direction: column; padding: 20rpx 0; }.field.block > text { width: auto; }.field textarea { width: 100%; min-height: 150rpx; padding: 16rpx; background: #f7f8f9; border-radius: 12rpx; box-sizing: border-box; font-size: 24rpx; }.choices { display: flex; flex-wrap: wrap; gap: 12rpx; }.chip { padding: 10rpx 18rpx; color: #52606d; background: #f0f4f2; border-radius: 999rpx; font-size: 23rpx; }.chip.active { color: #fff; background: #07c160; }.hint { margin-top: 8rpx; color: #7b8794; font-size: 22rpx; }.verify-card { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 26rpx; color: #7b8794; font-size: 23rpx; }.agreement { display: flex; align-items: flex-start; gap: 10rpx; margin: 24rpx 8rpx; color: #52606d; font-size: 23rpx; line-height: 1.5; }.save { color: #fff; background: #07c160; border-radius: 999rpx; font-size: 29rpx; font-weight: 600; }.save::after { border: 0; }.owner-actions { display: flex; gap: 16rpx; margin-top: 18rpx; }.owner-actions button { flex: 1; border-radius: 999rpx; font-size: 24rpx; }.owner-actions .danger { color: #b42318; background: #fff0ee; }.owner-actions button::after { border: 0; }
