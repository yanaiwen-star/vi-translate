.directory-page { padding: 24rpx 24rpx 150rpx; min-height: 100vh; background: #f5f7fa; box-sizing: border-box; }
.hero-card { padding: 30rpx; border-radius: 24rpx; color: #fff; background: linear-gradient(135deg, #07c160, #00a870); }
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-sub { margin-top: 10rpx; font-size: 24rpx; line-height: 1.6; opacity: .94; }
.search-row { display: flex; gap: 12rpx; margin-top: 22rpx; }
.search-input { flex: 1; height: 76rpx; padding: 0 24rpx; border-radius: 18rpx; background: #fff; font-size: 26rpx; }
.search-btn,.filter-btn { width: 104rpx; height: 76rpx; padding: 0; line-height: 76rpx; border-radius: 18rpx; font-size: 25rpx; }
.search-btn { color: #fff; background: #07c160; }.filter-btn { color: #166b45; background: #e8f8ef; }.search-btn::after,.filter-btn::after { border: 0; }
.language-scroll { margin: 22rpx 0; white-space: nowrap; }.language-row { display: flex; gap: 14rpx; }
.language-chip,.mini-chip { padding: 14rpx 24rpx; border-radius: 999rpx; color: #52606d; background: #fff; font-size: 25rpx; }
.language-chip.active,.mini-chip.active { color: #fff; background: #07c160; }
.filter-panel { padding: 24rpx; margin-bottom: 20rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(31,45,61,.06); }
.filter-line,.option-row { display: flex; align-items: center; min-height: 78rpx; gap: 12rpx; border-bottom: 1rpx solid #eef1f4; }.filter-label { width: 90rpx; color: #697586; font-size: 25rpx; }.picker-value,.filter-input { flex: 1; font-size: 26rpx; color: #1f2933; }.mini-chip { padding: 10rpx 18rpx; font-size: 23rpx; background: #f1f5f3; }
.filter-actions { display: flex; gap: 16rpx; margin-top: 22rpx; }.filter-actions button { flex: 1; border-radius: 999rpx; font-size: 26rpx; }.ghost-action { color: #07a954; background: #eef9f3; }.primary-action { color: #fff; background: #07c160; }.filter-actions button::after { border: 0; }
.result-meta { margin: 12rpx 4rpx 18rpx; color: #718096; font-size: 23rpx; }.state-card { display: flex; min-height: 260rpx; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; color: #718096; border-radius: 22rpx; background: #fff; }.state-card button { color: #fff; background: #07c160; border-radius: 999rpx; font-size: 25rpx; }.state-card button::after { border: 0; }
.spinner { width: 44rpx; height: 44rpx; border: 5rpx solid #d9f4e4; border-top-color: #07c160; border-radius: 50%; animation: spin .8s linear infinite; }@keyframes spin { to { transform: rotate(360deg); } }
.profile-list { display: flex; flex-direction: column; gap: 18rpx; }.profile-card { position: relative; padding: 26rpx; overflow: hidden; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(31,45,61,.055); }.example-badge { display: inline-flex; padding: 7rpx 16rpx; margin: -4rpx 0 18rpx; border-radius: 999rpx; color: #8a5a00; background: #fff4d6; font-size: 21rpx; font-weight: 600; }.profile-head { display: flex; align-items: center; gap: 18rpx; }.avatar { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border-radius: 20rpx; color: #078a48; background: #e6f8ee; font-size: 32rpx; font-weight: 700; }.profile-main { flex: 1; min-width: 0; }.name-line { display: flex; align-items: center; gap: 12rpx; }.profile-name { max-width: 390rpx; overflow: hidden; color: #1f2933; font-size: 31rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }.subject-badge { padding: 4rpx 10rpx; border-radius: 8rpx; color: #52606d; background: #f0f3f5; font-size: 20rpx; }.location { margin-top: 7rpx; color: #7b8794; font-size: 23rpx; }.tag-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }.tag { padding: 7rpx 14rpx; border-radius: 999rpx; color: #52606d; background: #f2f5f6; font-size: 21rpx; }.tag.language { color: #087b43; background: #e9f8f0; }.bio { margin-top: 18rpx; color: #4a5568; font-size: 25rpx; line-height: 1.6; }.card-foot { display: flex; justify-content: space-between; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #edf0f2; }.verify { color: #9a6b00; font-size: 22rpx; }.verify.verified { color: #078a48; }.view-link { color: #07a954; font-size: 23rpx; }.loading-more,.list-end { padding: 24rpx; text-align: center; color: #9aa5b1; font-size: 23rpx; }.join-button { position: fixed; right: 28rpx; bottom: 130rpx; z-index: 9; padding: 0 30rpx; border-radius: 999rpx; color: #fff; background: #07c160; font-size: 27rpx; font-weight: 600; box-shadow: 0 10rpx 30rpx rgba(7,193,96,.28); }.join-button::after { border: 0; }
