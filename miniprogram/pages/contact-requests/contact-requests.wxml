<view class="requests-page">
  <view class="tabs"><view class="tab {{activeTab === 'received' ? 'active' : ''}}" data-tab="received" bindtap="onTab">收到的申请</view><view class="tab {{activeTab === 'sent' ? 'active' : ''}}" data-tab="sent" bindtap="onTab">我的申请</view></view>
  <view class="state" wx:if="{{loading}}">正在加载…</view><view class="state" wx:elif="{{error}}"><text>{{error}}</text><button bindtap="onRetry">重试</button></view>
  <block wx:else>
    <view class="state" wx:if="{{activeTab === 'received' && received.length === 0}}">暂时没有收到申请</view>
    <view class="card" wx:for="{{received}}" wx:key="id" wx:if="{{activeTab === 'received'}}"><view class="top"><text class="status">{{item.statusLabel}}</text><text class="time">{{item.created_at}}</text></view><view class="purpose">{{item.purpose || '未填写联系用途'}}</view><view class="actions" wx:if="{{item.status === 'pending'}}"><button data-id="{{item.id}}" bindtap="onReject">拒绝</button><button class="primary" data-id="{{item.id}}" bindtap="onApprove">同意查看</button></view><button class="revoke" wx:elif="{{item.status === 'approved'}}" data-id="{{item.id}}" bindtap="onRevoke">撤销授权</button></view>
    <view class="state" wx:if="{{activeTab === 'sent' && sent.length === 0}}">暂时没有申请记录</view>
    <view class="card" wx:for="{{sent}}" wx:key="id" wx:if="{{activeTab === 'sent'}}"><view class="top"><text class="status">{{item.statusLabel}}</text><text class="time">{{item.created_at}}</text></view><view class="purpose">{{item.purpose || '未填写联系用途'}}</view><button class="primary single" wx:if="{{item.status === 'approved'}}" data-id="{{item.id}}" bindtap="onViewContact">查看已授权联系方式</button><button class="revoke" wx:if="{{item.status === 'pending' || item.status === 'approved'}}" data-id="{{item.id}}" bindtap="onRevoke">撤销申请</button></view>
  </block>
  <view class="modal-mask" wx:if="{{grantedContacts}}" bindtap="onCloseContact"><view class="contact-modal" catchtap="noop"><view class="modal-title">已授权联系方式</view><view wx:if="{{grantedContacts.wechat}}">微信：{{grantedContacts.wechat}}</view><view wx:if="{{grantedContacts.phone}}">电话：{{grantedContacts.phone}}</view><view wx:if="{{grantedContacts.email}}">邮箱：{{grantedContacts.email}}</view><view wx:if="{{!grantedContacts.wechat && !grantedContacts.phone && !grantedContacts.email}}">对方暂未填写联系方式</view><button bindtap="onCloseContact">关闭</button></view></view>
</view>
