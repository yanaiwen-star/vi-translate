/* pages/profile/profile.wxss */
.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 用户信息 */
.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 56rpx 32rpx 48rpx;
  background: linear-gradient(135deg, #0D7C5C, #4a90e2);
  color: #fff;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.user-sub {
  font-size: 24rpx;
  opacity: 0.85;
}

/* 通用卡片 */
.card {
  margin: 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 配额 */
.quota {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quota-info {
  flex: 1;
}

.quota-left {
  font-size: 30rpx;
  color: #333;
}

.quota-left .num {
  font-size: 44rpx;
  font-weight: 700;
  color: #0D7C5C;
  margin: 0 6rpx;
}

.quota-sub {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

.quota-sub .num {
  font-size: 32rpx;
  font-weight: 700;
  color: #0D7C5C;
  margin: 0 6rpx;
}

.quota-link {
  font-size: 26rpx;
  color: #0D7C5C;
}

/* 设置 */
.settings {
  padding: 0;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 30rpx;
  color: #333;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
}

.bind-btn {
  font-size: 28rpx;
  color: #07C160;
  background: transparent;
  border: none;
  padding: 0;
  line-height: 1.4;
}

.bind-btn::after {
  border: none;
}

/* 昵称值 */
.setting-value {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

/* 用户ID（可折行，点击复制） */
.userId-value {
  max-width: 440rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.3;
  word-break: break-all;
}

/* 昵称编辑弹层 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 28rpx;
  text-align: center;
}

.modal-input {
  width: 100%;
  height: 84rpx;
  background: #f5f7fa;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.modal-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
  line-height: 1.5;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  margin: 0;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  background: #f0f0f0;
  color: #666;
}

.modal-btn.confirm {
  background: #07C160;
  color: #fff;
}

/* 加入越南语互助群卡片 */
.wechat-group-card {
  margin: 32rpx 32rpx 64rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #07C160 0%, #06ad56 100%);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.15);
  color: #fff;
}

.wechat-group-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.wechat-group-desc {
  font-size: 26rpx;
  line-height: 1.6;
  opacity: 0.95;
  margin-bottom: 12rpx;
}

.wechat-group-id {
  font-weight: 700;
  background: rgba(255, 255, 255, 0.2);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin: 0 4rpx;
}

.wechat-group-hint {
  font-size: 22rpx;
  opacity: 0.75;
  text-align: right;
}
