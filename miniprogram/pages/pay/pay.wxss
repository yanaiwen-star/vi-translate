/* pages/pay/pay.wxss */
page {
  background: linear-gradient(180deg, #eaf5f0 0%, #f4f7f6 100%);
}

.page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.card {
  width: 100%;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 24rpx 60rpx -20rpx rgba(13, 124, 92, 0.35);
  padding: 60rpx 48rpx 56rpx;
  text-align: center;
}

.title {
  font-size: 44rpx;
  font-weight: 800;
  color: #14231e;
}

.sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8b9a95;
}

.state {
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.state-text {
  margin-top: 28rpx;
  font-size: 30rpx;
  color: #44544e;
}

.state-text.ok {
  color: #0d7c5c;
  font-weight: 700;
  font-size: 34rpx;
}

.state-text.err {
  color: var(--danger);
}

.state-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9aa8a3;
}

.spinner {
  width: 72rpx;
  height: 72rpx;
  border: 8rpx solid #e3efe9;
  border-top-color: #0d7c5c;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.ok-icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 50%;
  background: #0d7c5c;
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
}

.err-icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 50%;
  background: #fdecec;
  color: var(--danger);
  font-size: 56rpx;
  font-weight: 700;
}

.btn {
  margin: 36rpx 0 0;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #0d7c5c, #16a37b);
}

.btn.ghost {
  color: #0d7c5c;
  background: #eef6f2;
}

.btn::after {
  border: none;
}
