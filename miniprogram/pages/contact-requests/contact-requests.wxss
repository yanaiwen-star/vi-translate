.requests-page { min-height: 100vh; padding: 24rpx; background: #f5f7fa; box-sizing: border-box; }.tabs { display: flex; padding: 8rpx; margin-bottom: 20rpx; background: #fff; border-radius: 18rpx; }.tab { flex: 1; padding: 18rpx; color: #697586; text-align: center; border-radius: 14rpx; font-size: 25rpx; }.tab.active { color: #fff; background: #07c160; }.state { display: flex; min-height: 260rpx; align-items: center; justify-content: center; flex-direction: column; gap: 18rpx; color: #7b8794; background: #fff; border-radius: 20rpx; }.state button { color: #fff; background: #07c160; border-radius: 999rpx; }.state button::after { border: 0; }.card { padding: 24rpx; margin-bottom: 16rpx; background: #fff; border-radius: 20rpx; }.top { display: flex; justify-content: space-between; }.status { color: #078a48; font-size: 24rpx; font-weight: 600; }.time { color: #a0aab4; font-size: 20rpx; }.purpose { margin-top: 18rpx; color: #3e4c59; font-size: 25rpx; line-height: 1.6; }.actions { display: flex; gap: 14rpx; margin-top: 20rpx; }.actions button { flex: 1; border-radius: 999rpx; font-size: 24rpx; }.actions .primary,.single { color: #fff; background: #07c160; }.actions button::after,.single::after,.revoke::after { border: 0; }.single,.revoke { margin-top: 18rpx; border-radius: 999rpx; font-size: 24rpx; }.revoke { color: #b42318; background: #fff0ee; }.modal-mask { position: fixed; inset: 0; z-index: 20; display: flex; align-items: center; justify-content: center; padding: 40rpx; background: rgba(0,0,0,.45); }.contact-modal { width: 100%; padding: 32rpx; color: #3e4c59; background: #fff; border-radius: 24rpx; font-size: 26rpx; line-height: 2; }.modal-title { color: #1f2933; font-size: 31rpx; font-weight: 700; }.contact-modal button { margin-top: 22rpx; color: #fff; background: #07c160; border-radius: 999rpx; }.contact-modal button::after { border: 0; }
