.report-page { min-height: 100vh; padding: 24rpx; background: #f5f7fa; box-sizing: border-box; }.notice { padding: 20rpx; color: #7a5b15; background: #fff7df; border-radius: 16rpx; font-size: 22rpx; line-height: 1.6; }.card { margin-top: 18rpx; padding: 24rpx; background: #fff; border-radius: 20rpx; }.title { color: #1f2933; font-size: 28rpx; font-weight: 650; }.reason { display: flex; min-height: 78rpx; align-items: center; justify-content: space-between; color: #52606d; border-bottom: 1rpx solid #edf0f2; font-size: 25rpx; }.reason.active { color: #078a48; }.card input { height: 82rpx; margin-top: 14rpx; padding: 0 18rpx; background: #f5f7fa; border-radius: 12rpx; font-size: 24rpx; }.submit { margin-top: 24rpx; color: #fff; background: #d93025; border-radius: 999rpx; font-size: 27rpx; }.submit::after { border: 0; }
