.business-page { min-height: 100vh; padding: 24rpx 24rpx 160rpx; box-sizing: border-box; background: #f5f7fa; }
.business-head { display: flex; align-items: center; justify-content: space-between; padding: 30rpx; color: #fff; border-radius: 24rpx; background: linear-gradient(135deg,#07c160,#00a870); }
.head-title { font-size: 40rpx; font-weight: 700; }.head-sub { margin-top: 8rpx; font-size: 23rpx; opacity: .94; }.head-count { padding: 10rpx 18rpx; border-radius: 999rpx; background: rgba(255,255,255,.18); font-size: 23rpx; }
.filter-scroll { margin: 20rpx 0; white-space: nowrap; }.filter-row { display: flex; gap: 12rpx; }.filter-chip { padding: 13rpx 24rpx; color: #52606d; background: #fff; border-radius: 999rpx; font-size: 24rpx; }.filter-chip.active { color: #fff; background: #07c160; }
.section { margin-top: 20rpx; }.section-head { display: flex; align-items: center; gap: 12rpx; margin: 0 4rpx 14rpx; color: #1f2933; font-size: 29rpx; font-weight: 650; }.section-badge { padding: 4rpx 11rpx; color: #087b43; background: #dcf7e8; border-radius: 999rpx; font-size: 19rpx; }.section-note { margin-left: auto; color: #8a96a3; font-size: 19rpx; font-weight: 400; }
.business-card { margin-bottom: 16rpx; padding: 24rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 7rpx 22rpx rgba(31,45,61,.045); }.active-card { border: 1rpx solid #bdebd1; }.card-top { display: flex; align-items: flex-start; gap: 14rpx; }.card-title { flex: 1; color: #1f2933; font-size: 29rpx; font-weight: 650; }.status { flex: none; padding: 5rpx 10rpx; color: #7b8794; background: #f1f3f5; border-radius: 8rpx; font-size: 18rpx; }.status.active { color: #087b43; background: #e5f8ed; }.pair { margin-top: 12rpx; color: #07a954; font-size: 24rpx; font-weight: 600; }.summary { margin-top: 14rpx; color: #4a5568; font-size: 24rpx; line-height: 1.65; }.meta { display: flex; flex-wrap: wrap; gap: 9rpx; margin-top: 16rpx; }.meta text { padding: 7rpx 12rpx; color: #52606d; background: #f3f6f5; border-radius: 999rpx; font-size: 20rpx; }.industry { margin-top: 14rpx; color: #8a96a3; font-size: 21rpx; }.respond { margin: 18rpx 0 0; height: 66rpx; line-height: 66rpx; color: #fff; background: #07c160; border-radius: 999rpx; font-size: 24rpx; }.respond::after { border: 0; }
.match-notice,.empty { padding: 24rpx; color: #718096; background: #fff; border-radius: 18rpx; font-size: 22rpx; line-height: 1.6; text-align: center; }.footer-note { padding: 26rpx 14rpx; color: #8a96a3; font-size: 21rpx; line-height: 1.6; text-align: center; }
.publish-button { position: fixed; right: 28rpx; bottom: 130rpx; z-index: 9; padding: 0 30rpx; border-radius: 999rpx; color: #fff; background: #07c160; font-size: 27rpx; font-weight: 600; box-shadow: 0 10rpx 30rpx rgba(7,193,96,.28); }.publish-button::after { border: 0; }
