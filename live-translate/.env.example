# ============================================================
# vi-translate v2 部署环境变量模板
# 复制为 .env 并填入实际值，或直接跑 deploy/setup.sh 自动生成
# ============================================================

# --- PostgreSQL（setup.sh 会自动生成强随机密码覆盖） ---
POSTGRES_USER=vi_translate
POSTGRES_PASSWORD=change_me_to_a_strong_random_string
POSTGRES_DB=vi_translate
DATABASE_URL=postgresql+psycopg://vi_translate:change_me_to_a_strong_random_string@postgres:5432/vi_translate

# --- Redis（容器内部访问，无须密码；如需对外暴露请加 requirepass） ---
REDIS_URL=redis://redis:6379/0

# 译员目录联系方式专用 Fernet 密钥。生产环境生成：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DIRECTORY_CONTACT_KEY=
DIRECTORY_NEED_TTL_DAYS=7
DIRECTORY_CLEANUP_INTERVAL_SECONDS=900

# --- JWT（setup.sh 会自动生成强随机密钥覆盖） ---
JWT_SECRET=change_me_to_a_strong_random_string_at_least_64_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- DashScope（通义/Qwen 实时翻译，必填） ---
# 去 https://dashscope.console.aliyun.com/apiKey 申请
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
TRANSLATE_MODEL=qwen3.5-livetranslate-flash-realtime
# Fernet key used to encrypt customer-provided DashScope API keys.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QWEN_CREDENTIAL_KEY=replace_with_a_generated_fernet_key

# --- HTTP 安全 ---
# 允许的 CORS 来源（逗号分隔，勿用通配符；备案后用 https://yourdomain.com）
CORS_ORIGINS=http://localhost,http://127.0.0.1
MAX_BODY_BYTES=8000000

# --- Billing ---
# 后台额外长期赠送的免费字符额度（管理员可在后台调整），与每日免费分钟池叠加。
FREE_QUOTA_CHARS=5000
# 墙钟计费：每个登录用户每天免费赠送的实时同传分钟数（次日 UTC 0 点自动重置）。
# 套餐/赠送的「分钟」在授权时按 1 分钟 ≈ 2000 字符折算入池。
FREE_DAILY_MINUTES=30

# ============================================================
# WeChat Pay 支付参数（备案+商户号下来后再启用，先全部注释）
# ============================================================
# WECHAT_MCH_ID=1234567890
# WECHAT_APP_ID=              # 官网/公众号 Native+H5 支付 AppID（须关联到本商户号）
# WECHAT_MP_APP_ID=          # 小程序 AppID：JSAPI 支付 / wx.login / 手机号绑定都用它（与 WECHAT_APP_ID 不是同一个）
# WECHAT_MP_APP_SECRET=      # 小程序 AppSecret（微信公众平台「开发管理-开发设置」获取）
# WECHAT_API_V3_KEY=
# WECHAT_SERIAL_NO=
# WECHAT_PRIVATE_KEY_PATH=/opt/vi-translate/secrets/wechat_apiclient_key.pem
# WECHAT_NOTIFY_URL=https://yourdomain.com/pay/notify
# WECHAT_PAY_PUBLIC_KEY=
# WECHAT_PAY_PUBLIC_KEY_ID=

# ============================================================
# 微信小程序（仅用于手机号绑定 getPhoneNumber 解密，与微信支付 AppID 不同）
# AppID 即小程序 AppID；AppSecret 在微信公众平台「开发管理-开发设置」获取
# ============================================================
# WECHAT_MP_APP_ID=wxfabcc61911cff7f1
# WECHAT_MP_APP_SECRET=

# ============================================================
# 微信小程序虚拟支付（正式发布必填；不要把真实密钥提交到仓库）
# ============================================================
VIRTUALPAY_OFFER_ID=
VIRTUALPAY_SANDBOX_APP_KEY=
VIRTUALPAY_PROD_APP_KEY=
VIRTUALPAY_ENV=0
VIRTUALPAY_PRODUCT_PACK_SMALL=
VIRTUALPAY_PRODUCT_PACK_MEDIUM=
VIRTUALPAY_PRODUCT_PACK_LARGE=
WECHAT_VIRTUALPAY_TOKEN=
WECHAT_VIRTUALPAY_ENCODING_AES_KEY=

# ============================================================
# 阿里云短信 Dysmsapi（网页端手机号绑定验证码）
# 去 https://dysms.console.aliyun.com 申请签名与模板（模板需含 ${code} 变量）
# AccessKey 用 RAM 子账号，仅授予 AliyunDysmsFullAccess
# ============================================================
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=南宁市悦迅翻译
ALIYUN_SMS_TEMPLATE_CODE=SMS_194390031
ALIYUN_SMS_REGION=cn-hangzhou
# 本地未配置阿里云时，将验证码随接口返回以便联调（生产务必关掉）
DEV_RETURN_SMS_CODE=false
