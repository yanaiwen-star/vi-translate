.needs-page { min-height: 100vh; padding: 24rpx; background: #f5f7fa; box-sizing: border-box; }.privacy { padding: 20rpx; margin-bottom: 18rpx; color: #52606d; background: #eaf8f0; border-radius: 16rpx; font-size: 22rpx; line-height: 1.6; }.state { display: flex; min-height: 260rpx; align-items: center; justify-content: center; flex-direction: column; gap: 18rpx; color: #7b8794; background: #fff; border-radius: 20rpx; }.state button { color: #fff; background: #07c160; border-radius: 999rpx; }.state button::after { border: 0; }.need-card { padding: 24rpx; margin-bottom: 16rpx; background: #fff; border-radius: 20rpx; }.top { display: flex; justify-content: space-between; }.pair { color: #078a48; font-size: 27rpx; font-weight: 650; }.status { color: #8a6500; font-size: 22rpx; }.note { margin-top: 18rpx; color: #3e4c59; font-size: 25rpx; line-height: 1.6; }.meta { margin-top: 10rpx; color: #8a94a0; font-size: 21rpx; }.need-card button { margin-top: 18rpx; color: #b42318; background: #fff0ee; border-radius: 999rpx; font-size: 23rpx; }.need-card button::after { border: 0; }
