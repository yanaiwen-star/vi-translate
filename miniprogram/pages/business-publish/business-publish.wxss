.publish-page { min-height: 100vh; padding: 24rpx 24rpx 70rpx; box-sizing: border-box; background: #f5f7fa; }.intro { padding: 32rpx 30rpx; color: #fff; border-radius: 24rpx; background: linear-gradient(135deg,#07c160,#00a870); }.intro-title { font-size: 36rpx; font-weight: 700; }.intro-sub { margin-top: 8rpx; font-size: 24rpx; opacity: .94; }.privacy { margin: 20rpx 4rpx; padding: 18rpx 20rpx; color: #805b12; background: #fff7df; border-radius: 16rpx; font-size: 22rpx; line-height: 1.6; }.form-card { padding: 8rpx 26rpx; border-radius: 22rpx; background: #fff; }.field { display: flex; align-items: center; min-height: 92rpx; border-bottom: 1rpx solid #edf0f2; }.field.block,.note-field { align-items: flex-start; flex-direction: column; padding: 22rpx 0; gap: 16rpx; }.label { width: 150rpx; color: #52606d; font-size: 26rpx; }.picker,.input { flex: 1; color: #1f2933; font-size: 27rpx; text-align: right; }.chips { display: flex; gap: 14rpx; }.chip { padding: 12rpx 24rpx; color: #52606d; background: #f0f4f2; border-radius: 999rpx; font-size: 24rpx; }.chip.active { color: #fff; background: #07c160; }.note-input { width: 100%; height: 150rpx; padding: 18rpx; box-sizing: border-box; color: #1f2933; background: #f7f9f8; border-radius: 14rpx; font-size: 25rpx; line-height: 1.6; }.submit { margin-top: 26rpx; color: #fff; background: #07c160; border-radius: 999rpx; font-size: 29rpx; font-weight: 600; }.submit::after { border: 0; }.boundary { padding: 24rpx 12rpx; color: #7b8794; font-size: 22rpx; line-height: 1.6; text-align: center; }
